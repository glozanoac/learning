  author    = {Fletcher, R. and Reeves, C. M.},
  title     = {Function Minimization by Conjugate Gradients},
  journal   = {The Computer Journal},
  volume    = {7},
  number    = {2},
  pages     = {149--154},
  year      = {1964},
  doi       = {10.1093/comjnl/7.2.149}
}

% 0300: Line search. Introduces the Wolfe conditions (sufficient decrease + curvature) and shows
%       they guarantee convergence of descent methods (Zoutendijk-type argument).
%   prev: 0200 FletcherReeves1964    next: 0400 Wolfe1971
