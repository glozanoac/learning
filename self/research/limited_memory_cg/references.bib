  pages     = {226--235},
  year      = {1969},
  doi       = {10.1137/1011036}
}

% 0400: Line search (erratum). Corrects and completes the 1969 results. Short; read right after 0300.
%   prev: 0300 Wolfe1969             next: 0500 Powell1986
