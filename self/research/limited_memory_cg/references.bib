% 0100: Linear CG. Solves Ax=k for SPD A; conjugate directions, finite termination in n steps,
%       monotone decrease of the error, rounding-error analysis, the B-generalization BAx=Bk.
%   prev: --                    next: 0200 FletcherReeves1964
%   needs: --                   unlocks: 0200 FletcherReeves1964, 1500 Paige1976
%   file: papers/0100-HestenesStiefel_1952_Methods_of_Conjugate_Gradients_Linear_Systems.pdf
@article{HestenesStiefel1952,
  author    = {Hestenes, Magnus R. and Stiefel, Eduard},
  title     = {Methods of Conjugate Gradients for Solving Linear Systems},
  journal   = {Journal of Research of the National Bureau of Standards},
  volume    = {49},
  number    = {6},
  pages     = {409--436},
  year      = {1952},
  doi       = {10.6028/jres.049.044},
  note      = {Research Paper 2379}
}

% 0200: Nonlinear CG. First extension of CG to minimizing a general f: d_{k+1} = -g_{k+1} + beta_k d_k
%       with the FR choice beta = ||g_{k+1}||^2/||g_k||^2, plus line search and restarts.
%   prev: 0100 HestenesStiefel1952   next: 0300 Wolfe1969
%   needs: 0100 HestenesStiefel1952  unlocks: 0500 Powell1986, 1000 Shanno1978
%   file: papers/0200-FletcherReeves_1964_Function_Minimization_by_Conjugate_Gradients.pdf
